# Feishu Bot → opencode 桥（飞书聊天指挥本机 opencode CLI）
# feishuBot.mjs 通过 dotenv 加载本文件（import "dotenv/config"）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# opencode 工作目录（指令在这里执行）
OPENCODE_DIR=/Users/issuser/code

# 授权用户：逗号分隔的 open_id / user_id / union_id（任一匹配即放行）。
# 留空 = 拒绝所有用户。首次运行可留空，向机器人发一条消息，
# 回复会带上你的身份 id，填入这里后重启即可。
OPENCODE_ALLOWED_USERS=

# 可选：opencode 可执行文件路径（默认 opencode，走 PATH）
# OPENCODE_CMD=opencode
# 可选：opencode 数据目录重定向（XDG_DATA_HOME），沙箱/隔离环境需要
# OPENCODE_DATA_DIR=
# 可选：火山网关密钥。config 里 volcano provider 写的是 {env:VOLCANO_API_KEY}，
# launchd 启动的进程拿不到交互终端的 shell 变量；缺它时 LLM 调用会 401（对外表现为空回复/等到超时）。
# VOLCANO_API_KEY=
# 可选：固定 message 使用的模型（格式 provider/model，modelID 可含 /）。
# 不设则首次指令自动取 GET /config 的默认模型；解析失败时请求不携带 model。
# OPENCODE_MODEL=volcano/glm-5.2
# 可选：单条指令超时毫秒（默认不超时）
# OPENCODE_TIMEOUT_MS=600000
# 可选：serve 端口 / 进度推送端口 / 会话映射文件
# OPENCODE_SERVE_PORT=41234
# FEISHU_PROGRESS_PORT=41235
# FEISHU_SESSION_FILE=

# ===== Issue 3: 视频总结 =====
# yt-dlp 二进制路径(默认走 PATH,brew install yt-dlp 或 pip install yt-dlp)
# YT_DLP_BIN=yt-dlp
# Whisper API(无字幕时 fallback,推荐用这个,无需本地模型)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1
# 或本地 whisper.cpp 二进制(可选,与 OPENAI_API_KEY 二选一)
# WHISPER_CMD=/opt/whisper.cpp/main
# 视频最大时长(秒),超过则拒绝
# VIDEO_MAX_DURATION_SEC=3600

# 可选：agent 后端，opencode（默认）或 dsh-acp
# AGENT_BACKEND=opencode
# DSH ACP 启动参数；默认 dsh --profile acp
# DSH_CMD=dsh
# DSH_ARGS 为可选前置参数（空格分隔）。源码仓库启动：DSH_CMD=pnpm、DSH_ARGS=dsh、DSH_CWD=/path/to/deepseek-harness
# DSH_ARGS=
# DSH_PROFILE=acp
# 可选：覆盖 DSH 子进程的 DSH_HOME（会话持久化与 profile 根目录）
# DSH_HOME=
# 可选：DSH 子进程工作目录（默认 OPENCODE_DIR）；ACP session/new、resume 的 cwd 始终为 OPENCODE_DIR
# DSH_CWD=
# DSH 默认会话映射为 data/dsh-feishu-sessions.json，opencode 仍为 data/feishu-sessions.json；
# FEISHU_SESSION_FILE 可覆盖任一后端的默认映射文件。
