# Server
PORT=3000
HOST=127.0.0.1

# Frontend LLM registration uses the values typed in the UI.
# These examples are for scripts or local manual requests.
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2

# RAG embedding configuration. If omitted, RAG can reuse the registered LLM
# client when it supports OpenAI-compatible embeddings.
RAG_EMBEDDING_ENDPOINT=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=sk-your-api-key
RAG_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=
EMBEDDING_MAX_TOKENS=8191
