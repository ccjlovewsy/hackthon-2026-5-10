# Server
PORT=3000
HOST=127.0.0.1

# Frontend LLM registration uses the values typed in the UI.
# These examples are for scripts or local manual requests.
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2

# RAG embedding configuration. If omitted, RAG can reuse the registered LLM
# client when it supports OpenAI-compatible embeddings.
RAG_EMBEDDING_ENDPOINT=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=sk-your-api-key
RAG_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=
EMBEDDING_MAX_TOKENS=8191

# Feishu Bot → opencode 桥（飞书聊天指挥本机 opencode CLI）
# feishuBot.mjs 通过 dotenv 加载本文件（import "dotenv/config"）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# opencode 工作目录（指令在这里执行）
OPENCODE_DIR=/Users/issuser/code

# 授权用户：逗号分隔的 open_id / user_id / union_id（任一匹配即放行）。
# 留空 = 拒绝所有用户。首次运行可留空，向机器人发一条消息，
# 回复会带上你的身份 id，填入这里后重启即可。
OPENCODE_ALLOWED_USERS=

# 可选：opencode 可执行文件路径（默认 opencode，走 PATH）
# OPENCODE_CMD=opencode
# 可选：opencode 数据目录重定向（XDG_DATA_HOME），沙箱/隔离环境需要
# OPENCODE_DATA_DIR=
# 可选：单条指令超时毫秒（默认不超时）
# OPENCODE_TIMEOUT_MS=600000
